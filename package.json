{
  "name": "reverse-everything",
  "version": "0.0.8",
  "private": true,
  "description": "Evidence-first local reverse engineering and compatibility reconstruction workbench",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "npm run build -w @reverse/contracts && npm run build -w @reverse/evidence && npm run build -w @reverse/security && npm run build -w @reverse/ai && npm run build -w @reverse/workflow && npm run build -w @reverse/hardware && npm run build -w @reverse/firmware && npm run build -w @reverse/console && npm run build -w @reverse/planner && npm run build -w @reverse/game-revival && npm run build -w @reverse/legacy-revival && npm run build -w @reverse/autopilot && npm run build -w @reverse/core && npm run build -w @reverse/api && npm run build -w @reverse/worker && npm run build -w @reverse/cli && npm run build -w @reverse/desktop && npm run build -w @reverse/web",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "assets": "npm run build -w @reverse/web",
    "openapi": "node scripts/generate-openapi.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "package:server": "node scripts/package-server.mjs",
    "package:backup": "node scripts/package-backup.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "package:demos": "node scripts/package-demo-assets.mjs",
    "validate:skill": "node scripts/validate-skill.mjs",
    "release:provenance": "node scripts/release-provenance.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-readme-consistency.mjs",
    "defects:check": "node scripts/check-defect-register.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "npm": "10.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.5",
    "vitest": "3.2.4",
    "yazl": "3.3.1"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  }
}
