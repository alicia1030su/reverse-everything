{
  "name": "reverse-everything",
  "version": "0.0.1",
  "private": true,
  "description": "Evidence-first local reverse engineering and compatibility reconstruction workbench",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "npm run build -w @reverse/contracts && npm run build -w @reverse/evidence && npm run build -w @reverse/security && npm run build -w @reverse/ai && npm run build -w @reverse/workflow && npm run build -w @reverse/core && npm run build -w @reverse/api && npm run build -w @reverse/cli && npm run build -w @reverse/web",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "assets": "npm run build -w @reverse/web"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.5",
    "vitest": "3.2.4", "yazl": "3.3.1"  }
}
