RE_HOST=127.0.0.1
RE_PORT=4173
RE_DATA_DIR=./data
# Optional API-server allowlist for read-only game directory scanning.
# Only absolute directories and their descendants are allowed; unset or out-of-scope paths return 403.
# Separate multiple roots with ';' on Windows and ':' on Linux/Docker (container paths in Docker).
# RE_GAME_ROOTS=/absolute/games/owned-fps;/absolute/games/owned-rpg
RE_MAX_UPLOAD_MB=100
RE_TASK_TIMEOUT_MS=300000
RE_MAX_CONCURRENCY=1
RE_WORKER_MAX_RSS_MB=1024
# Browser analysis is opt-in. Never expose this service to a public interface.
RE_ALLOW_LOCAL_URLS=false
# Optional OpenAI-compatible model. No requests occur while disabled.
RE_AI_ENABLED=false
RE_AI_BASE_URL=http://127.0.0.1:11434/v1
RE_AI_MODEL=llama3.2
RE_AI_API_KEY=
